{
  "name": "omphalos",
  "version": "0.1.0",
  "type": "module",
  "description": "The monorepo for the Omphalos project",
  "license": "MIT",
  "repository": "https://github.com/OdatNurd/omphalos",
  "author": {
    "name": "OdatNurd",
    "email": "odatnurd@gmail.com",
    "url": "https://odatnurd.net"
  },
  "private": true,
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "app:dev": "pnpm --filter omphalos-app run dev",
    "app:dev:watch": "pnpm --filter omphalos-app run dev:watch",
    "docs:dev": "pnpm --filter omphalos-docs run dev",
    "docs:build": "pnpm --filter omphalos-docs run build",
    "docs:preview": "pnpm --filter omphalos-docs run preview",
    "docs:deploy": "pnpm --filter omphalos-docs run deploy",
    "create-bundle": "create-omphalos-bundle --workspace"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@odatnurd/omph": "workspace:*",
    "@odatnurd/create-omphalos-bundle": "workspace:*"
  }
}
