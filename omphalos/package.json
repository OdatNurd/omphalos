{
  "name": "omphalos-app",
  "version": "0.1.0",
  "type": "module",
  "description": "A web based stream control center similar to NodeCG",
  "license": "MIT",
  "repository": "https://github.com/OdatNurd/omphalos",
  "author": {
    "name": "OdatNurd",
    "email": "odatnurd@gmail.com",
    "url": "https://odatnurd.net"
  },
  "private": true,
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "start:srv": "node src/server",
    "start:srv:watch": "node --watch src/server",
    "build:dev": "rollup -c -w",
    "build:prod": "rollup -c",
    "dev": "concurrently --kill-others --names \"client,server\" \"pnpm build:dev\" \"pnpm start:srv\"",
    "dev:watch": "concurrently --kill-others --names \"client,server\" \"pnpm build:dev\" \"pnpm start:srv:watch\""
  },
  "imports": {
    "#core/*": "./src/server/*.js",
    "#api/*": "./src/client/api/*.js",
    "#common/*": "./src/common/*.js"
  },
  "dependencies": {
    "@axel669/event-bridge": "^1.0.2",
    "@axel669/joker": "^0.3.6",
    "compression": "^1.8.1",
    "convict": "^6.2.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "fecha": "^4.2.3",
    "fs-jetpack": "^5.1.0",
    "json5": "^2.2.3",
    "linkedom": "^0.18.13",
    "semver": "^7.3.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "svelte": "^5.56.9",
    "svelte-spa-router": "^5.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@axel669/rollup-copy-static": "^0.2.0",
    "@axel669/rollup-dollar-path": "^0.1.0",
    "@odatnurd/omphalos-common": "workspace:*",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "concurrently": "^10.0.3",
    "daisyui": "^5.7.16",
    "postcss": "^8.5.16",
    "rollup": "^4.62.2",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svelte": "^7.2.3",
    "tailwindcss": "^4.3.3"
  }
}
